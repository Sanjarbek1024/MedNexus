# Backend settings for local development: copy to backend/.env (never commit it).
# Environment variables override this file. Only GROQ_API_KEY is needed for the full demo;
# everything else has a working default. Docker Compose uses the root .env instead.

# --- AI report (Groq) ---------------------------------------------------------------------
# API key from https://console.groq.com/keys. Without it, results are shown without the AI report.
GROQ_API_KEY=
# Any Groq chat model with JSON mode, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b
# Seconds before an LLM request is abandoned.
# GROQ_TIMEOUT_S=30

# --- Storage ------------------------------------------------------------------------------
# PostgreSQL, e.g. postgresql://mednexus:<password>@localhost:5432/mednexus
# Unset: a SQLite file in DATA_DIR (zero-config development).
# DATABASE_URL=
# Uploaded studies, plus the SQLite database when DATABASE_URL is unset. Relative paths are
# resolved from the directory the API runs in (backend/).
# DATA_DIR=./data
# Largest accepted upload (keep client_max_body_size in frontend/nginx.conf in step).
# MAX_UPLOAD_MB=40

# --- Models -------------------------------------------------------------------------------
# auto | cpu | cuda
# DEVICE=auto
# Which analyzers run for which study type.
# REGISTRY_PATH=analyzers.yaml

# --- Security -----------------------------------------------------------------------------
# Signs session tokens. Set a long random value in production, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset: a random key is generated once and kept in DATA_DIR/.secret_key.
# SECRET_KEY=
# Derives patient pseudonyms from DICOM patient IDs. Set it in production and never change it,
# or new studies stop linking to earlier ones of the same patient. Unset: derived from SECRET_KEY.
# PSEUDONYM_KEY=
# Session cookies are Secure-only. Browsers accept that on http://localhost; set false only
# when serving plain http on another host (better: use HTTPS).
# COOKIE_SECURE=true
# Browser origins allowed to call the API directly (JSON list); the Vite dev server by default.
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Session lifetimes.
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7

# --- Abuse protection ---------------------------------------------------------------------
# Consecutive failed sign-ins that lock an account, and for how long.
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# Requests per minute: sign-in per client IP; analysis uploads and chat questions per user.
# LOGIN_RATE_PER_MINUTE=10
# ANALYSIS_RATE_PER_MINUTE=30
# CHAT_RATE_PER_MINUTE=20
