# Groq API key (https://console.groq.com/keys). Without it, results are shown without the AI report.
GROQ_API_KEY=
# Any Groq chat model with JSON mode, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b

# Optional
# DEVICE=auto            # auto | cpu | cuda
# DATA_DIR=./data        # SQLite database and stored cases
# CORS_ORIGINS=["http://localhost:5173"]
