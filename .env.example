# Docker Compose settings: copy to .env next to docker-compose.yml (never commit it).
# For local development without Docker, use backend/.env.example instead.

# Required: two different long random values, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY signs sessions. PSEUDONYM_KEY derives patient pseudonyms; never change it once
# studies are stored, or new studies stop linking to earlier ones of the same patient.
SECRET_KEY=
PSEUDONYM_KEY=

# Password of the bundled PostgreSQL (letters and digits: it is part of the database URL).
# Empty means "mednexus-local", which is fine on your own machine only. It is fixed when the
# database volume is first created.
POSTGRES_PASSWORD=

# Optional: AI reports (key from https://console.groq.com/keys) and the model that writes them.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision-language model that reads the image with the symptoms (differential with estimates).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Optional: set false only when serving plain http on a host other than localhost.
# COOKIE_SECURE=true
